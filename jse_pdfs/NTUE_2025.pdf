         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">button-static</rdf:li>
               <rdf:li xml:lang="x-repair">button-static</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:headline>
            <rdf:Alt>
               <rdf:li>Vector editable neomorphic buttons set. Sliders for  websites, mobile menu, navigation and apps. Simple elegant Neomorphism trendy 2020 designs element UI components isolated on white background</rdf:li>
            </rdf:Alt>
         </dc:headline>
