# Morning brief email credentials — copy to .env and fill in your values
# Get these from your SES SMTP settings (AWS Console → SES → SMTP Settings)
# Outgoing mail: Zoho SMTP. smtppro.zoho.com for custom-domain (paid) accounts;
# smtp.zoho.com for free/personal. MAIL_PASS must be a Zoho app-specific password
# when 2FA is enabled (accounts.zoho.com -> Security -> App Passwords).
MAIL_SERVER=smtppro.zoho.com
MAIL_PORT=587
MAIL_USER=jimmy@mutxri.com
MAIL_PASS=your_zoho_app_specific_password
MAIL_FROM=jimmy@mutxri.com

# X/Twitter social tier for market_bot.py (optional).
# Requires a paid X API tier — there is no free recent-search endpoint. Without
# this the bot reports the social tier as "disabled" and the other 25 news
# sources run normally.
X_BEARER_TOKEN=your_x_api_v2_bearer_token

# --- MUTXRI analyst (mutxri_ai.py) -------------------------------------------
# Language layer: statement explanation, market briefs, grounded Q&A, post
# drafting. Everything deterministic (ratios, flags, consistency audit, template
# drafts) runs without this.
ANTHROPIC_API_KEY=sk-ant-...

# --- Social publishing (mutxri_ai.py social publish) -------------------------
# Posting to X needs USER-CONTEXT OAuth 1.0a. The read-only X_BEARER_TOKEN above
# is for reading the timeline and cannot post.
X_API_KEY=your_x_app_consumer_key
X_API_SECRET=your_x_app_consumer_secret
X_ACCESS_TOKEN=your_x_user_access_token
X_ACCESS_SECRET=your_x_user_access_token_secret

# LinkedIn: an access token with w_organization_social, and the page/person URN.
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_URN=urn:li:organization:00000000
