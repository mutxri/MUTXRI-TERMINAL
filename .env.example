# X/Twitter social tier for market_bot.py (optional).
# Requires a paid X API tier — there is no free recent-search endpoint. Without
# this the bot reports the social tier as "disabled" and the other 25 news
# sources run normally.
X_BEARER_TOKEN=your_x_api_v2_bearer_token
