{
  "name": "mutxri-terminal",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "gh_pages_deploy",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/terminal", "destination": "/terminal/index.html" },
    { "source": "/terminal/", "destination": "/terminal/index.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/docs/", "destination": "/docs.html" },
    { "source": "/LINKS", "destination": "/LINKS.html" }
  ],
  "headers": [
    {
      "source": "/terminal/static_data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
