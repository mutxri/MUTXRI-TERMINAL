bled","vscode":"enabled"}}},"custom_code":{"css":"h5 {\n    font-family: Inter;\n}\n\n.App .rm-ReferenceMain, .markdown-body {\n    font-family: Inter, Arial, sans-serif !important;\n}\n\n.InputGroup {\n    background-color: #F7F8FA !important;\n}\n\n.rm-ReferenceMain .rm-Article {\n    max-width: none !important;\n}\n\n/*\n** TOP BAR\n*/\n\n.rm-Logo{\n    --header-logo-height:22px;\n}\n\ndiv[class*=' Header-left'],div[class^='Header-left'] {\n    padding-left: 16px;\n}\n\n/* Search bar header */\ndiv[class*=' Header-search'],div[class^='Header-search'] {\n    padding-right: 4px;\n}\n\n/* Search bar */\n.rm-SearchToggle {\n    border: 1px solid #e2e2e2 !important;\n    border-radius: 0px !important;\n    box-shadow: none !important;\n}\n\n@media only screen and (min-width: 770px) {\n    .rm-SearchToggle {\n        width: 249px !important;\n    }\n}\n\n/* Search bar icon */\n.rm-SearchToggle-icon {\n    color: #232A55 !important;\n}\n\n/* Search bar text */\n.rm-SearchToggle-placeholder {\n    font: normal normal normal 10px/12px Inter !important;\n    color: #232A55 !important;\n}\n\n/* Search bar shortcut text */\n.rm-SearchToggle-shortcut {\n    font: normal normal normal 10px/12px Inter !important;\n    color: #232A55 !important;\n}\n\n/*\n** SIDEBAR\n*/\n\n.hub-sidebar {\n    flex: 0 0 264px !important;\n}\n\n/* Sidebar main section */\ndiv[class*=' Main-QuickNav'],div[class^='Main-QuickNav'] {\n    padding-left: 6px;\n}\n\n/* `Jump To` search */\nbutton[class*=' QuickNav'],button[class^='QuickNav'] {\n    border: 1px solid #e2e2e2;\n    border-radius: 0px;\n    opacity: 1;\n    color: #232A55;\n    text-align: left;\n    font: normal normal normal 10px/12px Inter;\n    letter-spacing: 0px;\n    height: 30px;\n    padding-left: 16px;\n    padding-right: 18px;\n}\n\n/* `Jump To` search shortcut icon */\nspan[class*=' QuickNav-key'],span[class^='QuickNav-key'] {\n    border: none;\n    background: none;\n    font: normal normal normal 10px/12px Inter;\n}\n\n/* Remove top header from sidebar */\nh3[class*=' Sidebar-heading'] {\n  display: none; \n}\n\nh2[class^='Sidebar-heading'] {\n  text-transform: none !important;\n  color: #000 !important;\n  font-weight: 600 !important;\n  font-size: 15px !important;\n  margin-bottom: 5px;\n}\n\n/* Sidebar section header styling  */\na[class*=' Sidebar-link_parent'],a[class^='Sidebar-link_parent'] {\n    color: #181B38 !important;\n    font: normal normal 400 14px/16px Inter !important;\n    opacity: 1;\n    margin-bottom: 3px;\n}\n\n/* Sidebar body */\n.rm-Sidebar {\n    padding-left: 12px;\n}\n\n/* Sublists below sections */\n.subpages {\n    margin-bottom: 29px !important;\n}\n\n/* Endpoint list items in sidebar */\n.rm-Sidebar-link.childless {\n    font: normal normal normal 13px/19px Inter !important;\n    letter-spacing: 0px;\n    color: #232A55;\n    margin-left: 0px !important;\n    margin-bottom:0px;\n}\n\n.rm-Sidebar-section {\n  margin-top: 0px !important;\n  margin-bottom: 10px\n}\n\n\n.rm-Sidebar-list {\n  margin-bottom: 5px !important;\n}\n\n\n/*\n** BODY\n*/\n\n/* Headline container */\nheader[class*= ' headline-container'],header[class^='headline-container'] {\n    padding-bottom: 32px;\n}\n\n/* Title */\ndiv[class*=' headline-container-grid-item'] h1,div[class^='headline-container-grid-item'] h1 {\n    font: normal normal 300 35px/40px Inter !important;\n    color: #181B38 !important;\n    margin-bottom: 16px;\n}\n\n/* API Method in headline */\nspan[class*=' headline-container-api-method'],span[class^='headline-container-api-method'] {\n    margin-right: 12px;\n}\n\n/* Endpoint URL */\nspan[class*=' headline-container-article-info-url'],span[class^='headline-container-article-info-url'] {\n    font: normal normal normal 14px/17px Inter;\n    color: #232A55;\n    margin-top: 2px;\n}\n\n/* Doc Subtitle */\ndiv[role=\"doc-subtitle\"] {\n    margin-top: 34px !important;\n    font: normal normal normal 15px/23px Inter !important;\n    color: #181B38;\n}\n\n/* Reference section */\ndiv.Reference-section {\n    margin-top: 20px;\n}\n\n/* API Section Header headings */\nstrong[class*=' APISectionHeader-heading'],strong[class^='APISectionHeader-heading'] {\n    font: normal normal 600 13px/16px Inter;\n    color: #181B38;\n    letter-spacing: 0.52px;\n}\n\n/**\n * REQUEST HISTORY\n**/\n\n/* Request History Card */\ndiv.rm-APILogInfo {\n    background: #FFFFFF 0% 0% no-repeat padding-box;\n    border: 1px solid #ECF1F9;\n    border-radius: 10px;\n}\n\n/* Request History Card Header */\nbutton[class*=' APILogInfo-button'],button[class^='APILogInfo-button'] {\n    background: #F7F8FA 0% 0% no-repeat padding-box;\n    border: 1px solid #ECF1F9;\n    border-radius: 10px 10px 0px 0px;\n    padding: 13px 12px 13px 18px;\n}\n\n/* Request History # of calls text */\nspan[class*=' APILogInfo-button-calls'],span[class^='APILogInfo-button-calls'] {\n    font: normal normal 600 14px/28px Inter;\n    color: #181B38;\n}\n\n/* Request History timespan button */\nbutton[class*=' APILogInfo-button'] select,button[class^='APILogInfo-button'] select{\n    font: normal normal 600 14px/28px Inter;\n    color: #181B38;\n    background-image: url(data:image/svg+xml;base64,);\n    background-size: 6px;\n    padding-right: 16px;\n}\n\n/* Request History empty content */\ndiv[class*=' APILogInfo-empty-bottom'],div[class^='APILogInfo-empty-bottom'] {\n    font: normal normal normal 14px/17px Inter;\n    color: #232A55;\n    padding: 11px 18px 15px 18px;\n}\n\n/* Request History table */\ntable[class*=' LogsTable'] thead th,table[class^='LogsTable'] thead th {\n    font-family: Inter !important;\n}\n\n/* Request History footer button */\nbutton[class*=' APILogsTable-footer-button'],button[class^='APILogsTable-footer-button'] {\n    font-family: Inter;\n}\n\n/*\n** PATH PARAMS\n*/\n\n/* Param container sections */\n.rm-ParamContainer{\n    overflow-x: scroll;\n}\n\n/* These two selectors allow the parameter fields to reflow whole rather than being cut off */\n\n/* Param left */\ndiv[class*=' Param-left'],div[class^='Param-left'] {\n    flex-wrap: wrap;\n}\n\n/* Param header */\ndiv[class*=' Param-header'],div[class^='Param-header'] {\n    flex-wrap: wrap !important;\n}\n\n/* Param name */\nlabel[class*=' Param-name'],\nlabel[class^='Param-name'],\nspan[class*=' Param-name'],\nspan[class^='Param-name'] {\n    font: normal normal bold 14px/30px Hack;\n    color: #181B38;\n    margin-right: 10px !important;\n}\n\n/* Param type */\ndiv[class*=' Param-type'],div[class^='Param-type'] {\n    font: normal normal 400 13px/16px Inter;\n    color: #98A2B8;\n    margin-right: 10px !important;\n}\n\n/* Param required */\ndiv[class*=' Param-required'],div[class^='Param-required'] {\n    text-transform: uppercase;\n    font: normal normal bold 11px/21px Inter;\n    color: #FF5C88;\n}\n\n/* Param form */\ndiv[class*=' Param-form'],div[class^='Param-form'] {\n    max-width: 168px;\n}\n\n/* Param input */\n.rm-ParamInput {\n    border: 1px solid #BDC2D1 !important;\n    border-radius: 0px !important;\n}\n\n/* Param input invalid state */\n.rm-ParamInput.invalid {\n    border-color: #FF5C88 !important;\n}\n\n.field-description {\n  margin-top: 5px;\n  margin-bottom: 5px\n}\n\n/* Param description */\n.field-description.markdown-body p {\n    font: normal normal normal 14px/17px Inter;\n    color: #141414;\n}\n\n/*\n** BODY PARAMS\n*/\n\n/* Add param button */\nsection[class*=' Param-expand'],section[class^='Param-expand'] {\n    margin: 8px 4px;\n}\n\n/* Param accordion header */\nbutton[class*=' AccordionMultiSchema-header'],button[class^='AccordionMultiSchema-header'] {\n    background-color: #F7F8FA;\n    border-radius: 10px;\n}\n\n/* New param inner accordion */\ndiv[class*=' AccordionMultiSchema-label'],div[class^='AccordionMultiSchema-label'] {\n    font-family: Hack;\n    text-transform: initial;\n    color: #181B38;\n}\n\n/*\n** RESPONSES\n*/\n\n/* Response rows */\nbutton[class*=' APIResponseSchemaPicker-option'],button[class^='APIResponseSchemaPicker-option'] {\n    background-color: #F7F8FA;\n}\n\n/* Response row description text */\ndiv[class*=' APIResponseSchemaPicker-description'],div[class^='APIResponseSchemaPicker-description'] {\n    font: normal normal normal 14px/17px Inter;\n    color: #232A55;\n}\n\n/*\n** RESPONSE MODAL\n*/\n\n/* Response modal response select */\nselect[class*=' ResponseModal-header-select'],select[class^='ResponseModal-header-select'] {\n    font-family: Inter;\n}\n\n/* Response description */\n.readme-markdown {\n    font-family: Inter !important;\n    color: #181B38 !important;\n}\n\n/* Modal body */\nsection[class*=' Modal'] div[class*=' Modal-Body'],section[class^='Modal'] div[class^='Modal-Body'] {\n    background-color: #F7F8FA !important;\n}\n\n/* Container inside modal body */\ndiv[class*=' Modal-Body'] .rm-ParamContainer,div[class^='Modal-Body'] .rm-ParamContainer {\n    background-color: white !important;\n}\n\n/* Close button */\nfooter[class*=' Modal-Footer'],footer[class^='Modal-Footer'] {\n    font-family: Inter;\n}\n\n/*\n** RESPONSE CIRCLES\n*/\n\n.HTTPStatus-chit {\n    border: none !important;\n    box-shadow: none !important;\n    height: 8px !important;\n    width: 8px !important;\n}\n\n/*\n** UPDATED AT\n*/\n\n#updated-at {\n    font-family: Inter;\n}\n\n/*\n** PAGINATION\n*/\n\n/* Pagination text */\ndiv[class*=' Pagination-text'],div[class^='Pagination-text'] {\n    font-family: Inter;\n}\n\n/*\n** RIGHT PANE\n*/\n\n/*\n** REQUEST\n*/\n\n/* Playground header */\nheader[class*=' APIRequest-header1qZm0uqnEaFN'],header[class^='APIRequest-header1qZm0uqnEaFN'] {\n    background: #181B38 0% 0% no-repeat padding-box;\n    border-radius: 10px;\n}\n\n/* Playground */\n.rm-PlaygroundRequest {\n    background: #1E254A 0% 0% no-repeat padding-box !important;\n    border-radius: 10px;\n}\n\n/* Playground header title */\nspan[class*=' APIRequest-header-title'],span[class^='APIRequest-header-title'] {\n    color: white;\n    opacity: 0.7;\n}\n\n/* Playground example button */\nbutton[class*=' APIRequest-header-button'],button[class^='APIRequest-header-button']{\n    opacity: 0.7;\n}\n\n/* Playground text */\ndiv[class*=' APIRequest-instructions-body'],div[class^='APIRequest-instructions-body'] {\n    background-color: rgba(79, 101, 241, 0.25);\n}\n\ninput[class*=' APIRequest-instructions-input'],input[class^='APIRequest-instructions-input'] {\n    color: #0FE0B6;\n}\n\n.cm-s-material-palenight .cm-linerow {\n    color: #E2E7F0;\n}\n\n.cm-s-material-palenight .cm-variable {\n    color: #E2E7F0 !important;\n}\n\n.cm-s-material-palenight .cm-keyword {\n    color: #00CCFF !important;\n}\n\n.cm-s-material-palenight .cm-operator, .cm-s-material-palenight .cm-string, .cm-s-material-palenight .cm-def {\n    color: #FFC15D !important;\n}\n\n.cm-s-material-palenight .cm-property, .cm-s-material-palenight .cm-atom, .cm-s-material-palenight .cm-tag, .cm-s-material-palenight .cm-number {\n    color: #FA7F98 !important;\n}\n\n.cm-s-material-palenight .cm-builtin {\n    color: #0FE0B6 !important;\n}\n\n/* Playground footer */\nfooter[class*=' APIRequest-footer'],footer[class^='APIRequest-footer'] {\n    padding-right: 19px;\n    padding-bottom: 18px;\n}\n\n/* Try It Button */\n.rm-TryIt {\n    width: 100%;\n    background: #3B459A 0% 0% no-repeat padding-box !important;\n    border-radius: 18px !important;\n    letter-spacing: 0.3px;\n    color: #FFFFFF !important;\n    font: normal normal 400 15px/15px Inter !important;\n    text-transform: uppercase;\n}\n\n/*\n** PLAYGROUND RESPONSE\n*/\n.rm-PlaygroundResponse {\n    background: #F7F8FA 0% 0% no-repeat padding-box !important;\n    border: 1px solid #ECF1F9 !important;\n    border-radius: 10px !important;\n}\n\ndiv[class*=' APIResponse-empty'],div[class^='APIResponse-empty'] {\n    font: normal normal normal 14px/17px Inter !important;\n    color: #232A55 !important;\n}\n\n/*\n** METHOD BADGES\n*/\n\n/* All badges */\n.APIMethod, span[class*=' SearchResults-Method'], span[class^='SearchResults-Method'] {\n    font: normal normal 600 11px/11px Inter !important;\n    letter-spacing: 0.22px;\n    text-shadow: none !important;\n    border-radius: 0px !important;\n    box-shadow: none !important;\n    padding: 4px 6px;\n}\n\n.APIMethod {\n    height: 18px !important;\n}\n\nspan[class*=' SearchResults-Method'], span[class^='SearchResults-Method'] {\n    height: 10px !important;\n}\n\n.APIMethod_fixedWidth {\n    width: auto !important;\n}","js":null,"html":{"header":"\u003clink\n      rel=\"stylesheet\"\n      href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap\"\n/>\n\u003clink\n      rel=\"stylesheet\"\n      href=\"//cdn.jsdelivr.net/npm/hack-font@3.3.0/build/web/hack.css\"\n/>","home_footer":null,"page_footer":null}},"header":{"type":"solid","gradient_color":null,"subnav":{"alignment":"start"},"link_style":"buttons","overlay":{"fill":"auto","type":"triangles","position":"top-left","image":{"uri":null,"url":null,"name":null,"width":null,"height":null,"color":null,"links":{"original_url":null}}}},"navigation":{"collapsible_categories":"disabled","breadcrumbs":"disabled","first_page":"reference","left":[],"logo_link":"landing_page","page_icons":"enabled","right":[],"search_modal":"classic","sub_nav":[],"subheader_layout":"links","version":"disabled","links":{"home":{"label":"Home","visibility":"disabled"},"graphql":{"label":"GraphQL","visibility":"disabled","schema":null},"guides":{"label":"Guides","alias":"OpenAPI spec","visibility":"enabled"},"reference":{"label":"API Reference","alias":null,"visibility":"enabled"},"recipes":{"label":"Recipes","alias":null,"visibility":"disabled"},"changelog":{"label":"Changelog","alias":null,"visibility":"disabled"},"discussions":{"label":"Discussions","alias":null,"visibility":"disabled"}}}},"i18n":{"defaultLanguage":"en","languages":[{"code":"en","type":"manual"}],"state":"disabled","do_not_translate_words":[]}}},"version":{"_id":"60496c046cefd7006cceb75b",